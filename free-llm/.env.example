# Copia in .env e inserisci solo le chiavi che hai. Non committare .env.
# Chiave che protegge il tuo proxy locale (inventala tu, deve iniziare con sk-)
LITELLM_MASTER_KEY=sk-cambia-questa-chiave

# Provider APIs
AION_API_KEY=            # https://www.aionlabs.ai/app/api-keys/
COHERE_API_KEY=          # https://dashboard.cohere.com/api-keys
GEMINI_API_KEY=          # https://aistudio.google.com/app/apikey
MISTRAL_API_KEY=         # https://console.mistral.ai/api-keys
ZAI_API_KEY=             # https://z.ai (oppure https://open.bigmodel.cn/usercenter/apikeys)

# Inference providers
CLOUDFLARE_API_KEY=      # https://dash.cloudflare.com/profile/api-tokens (permesso Workers AI)
CLOUDFLARE_ACCOUNT_ID=   # ID account Cloudflare
GONKA_API_KEY=           # https://app.gonkabroker.com/signup
GROQ_API_KEY=            # https://console.groq.com/keys
MODELSCOPE_API_KEY=      # https://modelscope.cn/my/myaccesstoken
NVIDIA_API_KEY=          # https://build.nvidia.com/explore/discover
OLLAMA_API_KEY=          # https://ollama.com/settings/keys
OPENROUTER_API_KEY=      # https://openrouter.ai/keys
SILICONFLOW_API_KEY=     # https://cloud.siliconflow.cn/account/ak

# Provider senza chiave: lascia il valore segnaposto (o metti il token gratuito LLM7)
KILO_API_KEY=anonymous
LLM7_API_KEY=anonymous   # token gratuito: https://token.llm7.io
OVH_API_KEY=anonymous
